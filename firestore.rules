rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /{store}/{id} {
      allow read: if signedIn() && store in ['branches', 'inspections', 'actions'];
      allow create: if signedIn() && store in ['branches', 'inspections', 'actions'];
      // Finalized inspections are locked: no further edits or deletes from the app.
      allow update: if signedIn() && store in ['branches', 'actions']
                    || signedIn() && store == 'inspections' && resource.data.status != 'finalized';
      allow delete: if signedIn() && (store in ['branches', 'actions']
                    || store == 'inspections' && resource.data.status != 'finalized');
    }
  }
}
